# Copia este archivo como .env y llena los valores. El archivo .env NO se comparte.
# Token que te da @BotFather en Telegram (/newbot)
BOT_TOKEN=
# Clave que Telegram manda en cada mensaje al webhook (inventa una larga, solo letras y números)
WEBHOOK_SECRET=
# Clave para que el cron externo pueda llamar a /tick (inventa otra)
TICK_KEY=
# 1 = modo demostración con datos simulados y comando /demo; 0 = uso real
DEMO=1
